# Copy to .env.local (repo root), web/.env.local, and desktop/.env.local.
# All three should have the SAME values (same Supabase project).

# Web app (Next.js reads NEXT_PUBLIC_*)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Desktop app (Vite reads VITE_*)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
