{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OptaPrompter",
  "version": "0.1.0",
  "identifier": "com.optaprompter.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "prompter",
        "title": "OptaPrompter",
        "width": 1200,
        "height": 520,
        "minWidth": 600,
        "minHeight": 260,
        "x": 100,
        "y": 80,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "fullscreen": false,
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "visibleOnAllWorkspaces": true,
        "contentProtected": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity"
  },
  "plugins": {}
}
